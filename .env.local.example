# Copy this to .env.local and fill in values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Solana
NEXT_PUBLIC_PROGRAM_ID=RL1dgerXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_BACKEND_SECRET_KEY=your-base58-keypair-secret

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Set to "true" to use chain-independent fallback (no devnet dependency)
NEXT_PUBLIC_MOCK_CHAIN=true
